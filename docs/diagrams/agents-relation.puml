@startuml
title Document Relationships

skinparam linetype ortho

' Primary and Secondary Color Scheme with High Contrast
!define AGENT_COLOR #BBDEFB
!define PROMPT_COLOR #E1BEE7
!define SKILL_COLOR #FFE0B2
!define KNOWLEDGE_COLOR #C8E6C9
!define DOC_COLOR #FFCDD2

!define AGENT_ARROW #1976D2
!define PROMPT_ARROW #7B1FA2
!define SKILL_ARROW #F57C00
!define KNOWLEDGE_ARROW #388E3C
!define DOC_ARROW #D32F2F

skinparam component {
  BorderColor #424242
  FontName Arial
  FontSize 11
}

skinparam package {
  BackgroundColor<<agents>> #BBDEFB
  BackgroundColor<<prompts>> #E1BEE7
  BackgroundColor<<skills>> #FFE0B2
  BackgroundColor<<knowledge>> #C8E6C9
  BackgroundColor<<docs>> #FFCDD2
  BorderColor #616161
  FontStyle bold
}

package "Agents" <<agents>> {
  component "chimera" as chimera AGENT_COLOR
  component "developer" as developer AGENT_COLOR
  component "maintainer" as maintainer AGENT_COLOR
  component "manager" as manager AGENT_COLOR
  component "writer" as writer AGENT_COLOR
}

package "Prompts" <<prompts>> {
  component "code.prompt" as code_prompt PROMPT_COLOR
  component "explain.prompt" as explain_prompt PROMPT_COLOR
  component "maintain.prompt" as maintain_prompt PROMPT_COLOR
  component "plan.prompt" as plan_prompt PROMPT_COLOR
  component "research.prompt" as research_prompt PROMPT_COLOR
  component "review.prompt" as review_prompt PROMPT_COLOR
  component "template.prompt" as template_prompt PROMPT_COLOR
  component "work.prompt" as work_prompt PROMPT_COLOR
  component "write.prompt" as write_prompt PROMPT_COLOR
}

package "Skills" <<skills>> {
  component "automate" as automate SKILL_COLOR
  component "code" as code SKILL_COLOR
  component "explain" as explain SKILL_COLOR
  component "maintain" as maintain SKILL_COLOR
  component "manage" as manage SKILL_COLOR
  component "plan" as plan SKILL_COLOR
  component "research" as research SKILL_COLOR
  component "review" as review SKILL_COLOR
  component "template" as template SKILL_COLOR
  component "write" as write SKILL_COLOR
}

package "Knowledge" <<knowledge>> {
  component "automation" as automation KNOWLEDGE_COLOR
  component "cmr" as cmr KNOWLEDGE_COLOR
  component "deployment" as deployment KNOWLEDGE_COLOR
  component "operating" as operating KNOWLEDGE_COLOR
  component "planning" as planning KNOWLEDGE_COLOR
  component "repository" as repository KNOWLEDGE_COLOR
  component "researching" as researching KNOWLEDGE_COLOR
  component "reviewing" as reviewing KNOWLEDGE_COLOR
  component "validating" as validating KNOWLEDGE_COLOR
}

package "Documentation" <<docs>> {
  component "AGENTS" as AGENTS DOC_COLOR
  component "ARCHITECTURE" as ARCHITECTURE DOC_COLOR
  component "CHANGELOG" as CHANGELOG DOC_COLOR
  component "CODE_OF_CONDUCT" as CODE_OF_CONDUCT DOC_COLOR
  component "CONTRIBUTING" as CONTRIBUTING DOC_COLOR
  component "DEVELOPMENT" as DEVELOPMENT DOC_COLOR
  component "ORGANIZATION" as ORGANIZATION DOC_COLOR
  component "README" as README DOC_COLOR
  component "ROADMAP" as ROADMAP DOC_COLOR
  component "SECURITY" as SECURITY DOC_COLOR
  component "STRUCTURE" as STRUCTURE DOC_COLOR
}

' Relationships
automate -[SKILL_ARROW]-> automation
automate -[SKILL_ARROW]-> deployment
automation -[KNOWLEDGE_ARROW]-> ARCHITECTURE
automation -[KNOWLEDGE_ARROW]-> cmr
automation -[KNOWLEDGE_ARROW]-> operating
chimera -[AGENT_ARROW]-> review
chimera -[AGENT_ARROW]-> template
chimera -[AGENT_ARROW]-> write
cmr -[KNOWLEDGE_ARROW]-> ORGANIZATION
cmr -[KNOWLEDGE_ARROW]-> README
cmr -[KNOWLEDGE_ARROW]-> STRUCTURE
code -[SKILL_ARROW]-> automation
code -[SKILL_ARROW]-> deployment
code -[SKILL_ARROW]-> operating
code_prompt -[PROMPT_ARROW]-> developer
deployment -[KNOWLEDGE_ARROW]-> ARCHITECTURE
deployment -[KNOWLEDGE_ARROW]-> CHANGELOG
deployment -[KNOWLEDGE_ARROW]-> operating
deployment -[KNOWLEDGE_ARROW]-> validating
developer -[AGENT_ARROW]-> code
developer -[AGENT_ARROW]-> explain
developer -[AGENT_ARROW]-> research
explain -[SKILL_ARROW]-> researching
explain_prompt -[PROMPT_ARROW]-> developer
maintain -[SKILL_ARROW]-> cmr
maintain -[SKILL_ARROW]-> repository
maintain_prompt -[PROMPT_ARROW]-> maintainer
maintainer -[AGENT_ARROW]-> maintain
maintainer -[AGENT_ARROW]-> review
manage -[SKILL_ARROW]-> cmr
manage -[SKILL_ARROW]-> repository
manager -[AGENT_ARROW]-> explain
manager -[AGENT_ARROW]-> plan
manager -[AGENT_ARROW]-> research
manager -[AGENT_ARROW]-> review
operating -[KNOWLEDGE_ARROW]-> CONTRIBUTING
operating -[KNOWLEDGE_ARROW]-> DEVELOPMENT
operating -[KNOWLEDGE_ARROW]-> SECURITY
plan -[SKILL_ARROW]-> planning
plan_prompt -[PROMPT_ARROW]-> manager
planning -[KNOWLEDGE_ARROW]-> CHANGELOG
planning -[KNOWLEDGE_ARROW]-> CONTRIBUTING
planning -[KNOWLEDGE_ARROW]-> ROADMAP
repository -[KNOWLEDGE_ARROW]-> ARCHITECTURE
repository -[KNOWLEDGE_ARROW]-> ORGANIZATION
repository -[KNOWLEDGE_ARROW]-> STRUCTURE
research -[SKILL_ARROW]-> researching
research_prompt -[PROMPT_ARROW]-> developer
researching -[KNOWLEDGE_ARROW]-> ARCHITECTURE
researching -[KNOWLEDGE_ARROW]-> ORGANIZATION
researching -[KNOWLEDGE_ARROW]-> README
researching -[KNOWLEDGE_ARROW]-> STRUCTURE
review -[SKILL_ARROW]-> reviewing
review -[SKILL_ARROW]-> validating
review_prompt -[PROMPT_ARROW]-> maintainer
reviewing -[KNOWLEDGE_ARROW]-> ARCHITECTURE
reviewing -[KNOWLEDGE_ARROW]-> CODE_OF_CONDUCT
reviewing -[KNOWLEDGE_ARROW]-> CONTRIBUTING
reviewing -[KNOWLEDGE_ARROW]-> ORGANIZATION
reviewing -[KNOWLEDGE_ARROW]-> STRUCTURE
template -[SKILL_ARROW]-> validating
template_prompt -[PROMPT_ARROW]-> chimera
validating -[KNOWLEDGE_ARROW]-> ORGANIZATION
validating -[KNOWLEDGE_ARROW]-> STRUCTURE
write -[SKILL_ARROW]-> cmr
write -[SKILL_ARROW]-> reviewing
write_prompt -[PROMPT_ARROW]-> writer
writer -[AGENT_ARROW]-> explain
writer -[AGENT_ARROW]-> review
writer -[AGENT_ARROW]-> write

@enduml