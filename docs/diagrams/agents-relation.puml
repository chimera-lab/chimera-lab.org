@startuml
title Agents Relation

skinparam linetype ortho

' Primary and Secondary Color Scheme with High Contrast
!define AGENT_COLOR #BBDEFB
!define PROMPT_COLOR #E1BEE7
!define SKILL_COLOR #FFE0B2
!define KNOWLEDGE_COLOR #C8E6C9
!define DOC_COLOR #FFCDD2

!define AGENT_ARROW #1976D2
!define PROMPT_ARROW #7B1FA2
!define SKILL_ARROW #F57C00
!define KNOWLEDGE_ARROW #388E3C
!define DOC_ARROW #D32F2F

skinparam component {
  BorderColor #424242
  FontName Arial
  FontSize 11
}

skinparam package {
  BackgroundColor<<agents>> #BBDEFB
  BackgroundColor<<prompts>> #E1BEE7
  BackgroundColor<<skills>> #FFE0B2
  BackgroundColor<<knowledge>> #C8E6C9
  BackgroundColor<<docs>> #FFCDD2
  BorderColor #616161
  FontStyle bold
}

package "Agents" <<agents>> {
  component "chimera" as agent_chimera AGENT_COLOR
  component "developer" as agent_developer AGENT_COLOR
  component "maintainer" as agent_maintainer AGENT_COLOR
  component "manager" as agent_manager AGENT_COLOR
  component "writer" as agent_writer AGENT_COLOR
}

package "Prompts" <<prompts>> {
  component "code" as prompt_code PROMPT_COLOR
  component "explain" as prompt_explain PROMPT_COLOR
  component "maintain" as prompt_maintain PROMPT_COLOR
  component "plan" as prompt_plan PROMPT_COLOR
  component "research" as prompt_research PROMPT_COLOR
  component "review" as prompt_review PROMPT_COLOR
  component "template" as prompt_template PROMPT_COLOR
  component "work" as prompt_work PROMPT_COLOR
  component "write" as prompt_write PROMPT_COLOR
}

package "Skills" <<skills>> {
  component "automate" as skill_automate SKILL_COLOR
  component "code" as skill_code SKILL_COLOR
  component "explain" as skill_explain SKILL_COLOR
  component "maintain" as skill_maintain SKILL_COLOR
  component "manage" as skill_manage SKILL_COLOR
  component "plan" as skill_plan SKILL_COLOR
  component "research" as skill_research SKILL_COLOR
  component "review" as skill_review SKILL_COLOR
  component "template" as skill_template SKILL_COLOR
  component "write" as skill_write SKILL_COLOR
}

package "Knowledge" <<knowledge>> {
  component "automation" as knowledge_automation KNOWLEDGE_COLOR
  component "cmr" as knowledge_cmr KNOWLEDGE_COLOR
  component "deployment" as knowledge_deployment KNOWLEDGE_COLOR
  component "operating" as knowledge_operating KNOWLEDGE_COLOR
  component "planning" as knowledge_planning KNOWLEDGE_COLOR
  component "repository" as knowledge_repository KNOWLEDGE_COLOR
  component "researching" as knowledge_researching KNOWLEDGE_COLOR
  component "reviewing" as knowledge_reviewing KNOWLEDGE_COLOR
  component "validating" as knowledge_validating KNOWLEDGE_COLOR
}

package "Documentation" <<docs>> {
  component "AGENTS" as doc_AGENTS DOC_COLOR
  component "ARCHITECTURE" as doc_ARCHITECTURE DOC_COLOR
  component "CHANGELOG" as doc_CHANGELOG DOC_COLOR
  component "CODE_OF_CONDUCT" as doc_CODE_OF_CONDUCT DOC_COLOR
  component "CONTRIBUTING" as doc_CONTRIBUTING DOC_COLOR
  component "DEVELOPMENT" as doc_DEVELOPMENT DOC_COLOR
  component "ORGANIZATION" as doc_ORGANIZATION DOC_COLOR
  component "README" as doc_README DOC_COLOR
  component "ROADMAP" as doc_ROADMAP DOC_COLOR
  component "SECURITY" as doc_SECURITY DOC_COLOR
  component "STRUCTURE" as doc_STRUCTURE DOC_COLOR
  component "TEMPLATE" as doc_TEMPLATE DOC_COLOR
}

' Relationships
agent_chimera -[AGENT_ARROW]-> skill_review
agent_chimera -[AGENT_ARROW]-> skill_template
agent_chimera -[AGENT_ARROW]-> skill_write
agent_developer -[AGENT_ARROW]-> skill_code
agent_developer -[AGENT_ARROW]-> skill_explain
agent_developer -[AGENT_ARROW]-> skill_research
agent_maintainer -[AGENT_ARROW]-> skill_maintain
agent_maintainer -[AGENT_ARROW]-> skill_review
agent_manager -[AGENT_ARROW]-> skill_explain
agent_manager -[AGENT_ARROW]-> skill_plan
agent_manager -[AGENT_ARROW]-> skill_research
agent_manager -[AGENT_ARROW]-> skill_review
agent_writer -[AGENT_ARROW]-> skill_explain
agent_writer -[AGENT_ARROW]-> skill_review
agent_writer -[AGENT_ARROW]-> skill_write
knowledge_automation -[KNOWLEDGE_ARROW]-> doc_ARCHITECTURE
knowledge_automation -[KNOWLEDGE_ARROW]-> knowledge_cmr
knowledge_automation -[KNOWLEDGE_ARROW]-> knowledge_operating
knowledge_cmr -[KNOWLEDGE_ARROW]-> doc_ORGANIZATION
knowledge_cmr -[KNOWLEDGE_ARROW]-> doc_README
knowledge_cmr -[KNOWLEDGE_ARROW]-> doc_STRUCTURE
knowledge_deployment -[KNOWLEDGE_ARROW]-> doc_ARCHITECTURE
knowledge_deployment -[KNOWLEDGE_ARROW]-> doc_CHANGELOG
knowledge_deployment -[KNOWLEDGE_ARROW]-> knowledge_operating
knowledge_deployment -[KNOWLEDGE_ARROW]-> knowledge_validating
knowledge_operating -[KNOWLEDGE_ARROW]-> doc_CONTRIBUTING
knowledge_operating -[KNOWLEDGE_ARROW]-> doc_DEVELOPMENT
knowledge_operating -[KNOWLEDGE_ARROW]-> doc_SECURITY
knowledge_planning -[KNOWLEDGE_ARROW]-> doc_CHANGELOG
knowledge_planning -[KNOWLEDGE_ARROW]-> doc_CONTRIBUTING
knowledge_planning -[KNOWLEDGE_ARROW]-> doc_ROADMAP
knowledge_repository -[KNOWLEDGE_ARROW]-> doc_ARCHITECTURE
knowledge_repository -[KNOWLEDGE_ARROW]-> doc_ORGANIZATION
knowledge_repository -[KNOWLEDGE_ARROW]-> doc_STRUCTURE
knowledge_researching -[KNOWLEDGE_ARROW]-> doc_ARCHITECTURE
knowledge_researching -[KNOWLEDGE_ARROW]-> doc_ORGANIZATION
knowledge_researching -[KNOWLEDGE_ARROW]-> doc_README
knowledge_researching -[KNOWLEDGE_ARROW]-> doc_STRUCTURE
knowledge_reviewing -[KNOWLEDGE_ARROW]-> doc_ARCHITECTURE
knowledge_reviewing -[KNOWLEDGE_ARROW]-> doc_CODE_OF_CONDUCT
knowledge_reviewing -[KNOWLEDGE_ARROW]-> doc_CONTRIBUTING
knowledge_reviewing -[KNOWLEDGE_ARROW]-> doc_ORGANIZATION
knowledge_reviewing -[KNOWLEDGE_ARROW]-> doc_STRUCTURE
knowledge_validating -[KNOWLEDGE_ARROW]-> doc_ORGANIZATION
knowledge_validating -[KNOWLEDGE_ARROW]-> doc_STRUCTURE
prompt_code -[PROMPT_ARROW]-> agent_developer
prompt_explain -[PROMPT_ARROW]-> agent_developer
prompt_maintain -[PROMPT_ARROW]-> agent_maintainer
prompt_plan -[PROMPT_ARROW]-> agent_manager
prompt_research -[PROMPT_ARROW]-> agent_developer
prompt_review -[PROMPT_ARROW]-> agent_maintainer
prompt_template -[PROMPT_ARROW]-> agent_chimera
prompt_write -[PROMPT_ARROW]-> agent_writer
skill_automate -[SKILL_ARROW]-> knowledge_automation
skill_automate -[SKILL_ARROW]-> knowledge_deployment
skill_code -[SKILL_ARROW]-> knowledge_automation
skill_code -[SKILL_ARROW]-> knowledge_deployment
skill_code -[SKILL_ARROW]-> knowledge_operating
skill_explain -[SKILL_ARROW]-> knowledge_researching
skill_maintain -[SKILL_ARROW]-> knowledge_cmr
skill_maintain -[SKILL_ARROW]-> knowledge_repository
skill_manage -[SKILL_ARROW]-> knowledge_cmr
skill_manage -[SKILL_ARROW]-> knowledge_repository
skill_plan -[SKILL_ARROW]-> knowledge_planning
skill_research -[SKILL_ARROW]-> knowledge_researching
skill_review -[SKILL_ARROW]-> knowledge_reviewing
skill_review -[SKILL_ARROW]-> knowledge_validating
skill_template -[SKILL_ARROW]-> knowledge_validating
skill_write -[SKILL_ARROW]-> knowledge_cmr
skill_write -[SKILL_ARROW]-> knowledge_reviewing

@enduml