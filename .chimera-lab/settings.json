{
  "github": {
    "organization": "chimera-lab",
    "homepage": "https://chimera-lab.org",
    "email": "contact@chimera-lab.org",
    "location": "Global"
  },
  "repositories": {
    "defaults": {
      "visibility": "public",
      "has_wiki": false,
      "has_projects": true,
      "has_downloads": true,
      "is_template": false,
      "allow_forking": true,
      "allow_squash_merge": true,
      "allow_merge_commit": true,
      "allow_rebase_merge": true,
      "delete_branch_on_merge": true
    },
    "protection": {
      "require_pull_request_reviews": 1,
      "require_status_checks": true,
      "require_branches_up_to_date": true,
      "enforce_admins": true,
      "protected_branches": [
        "main",
        "master",
        "develop"
      ]
    }
  },
  "documentation": {
    "required_files": [
      "README.md",
      "LICENSE",
      ".gitignore",
      ".github/CONTRIBUTING.md",
      ".github/workflows/",
      ".chimera-lab/meta.json"
    ],
    "readme_sections": [
      "Overview",
      "Installation",
      "Usage",
      "Contributing",
      "License"
    ]
  },
  "labels": {
    "source": "labels.json",
    "apply_on_creation": true,
    "categories": [
      "common",
      "general",
      "infrastructure",
      "interface",
      "embedded",
      "study",
      "organization"
    ]
  },
  "milestones": {
    "source": "milestones.json",
    "template": "quarterly",
    "duration_days": 90,
    "pattern": "Q? YYYY Release"
  },
  "automation": {
    "stale_issue_days": 90,
    "archive_old_issues": false,
    "auto_delete_old_releases": false,
    "auto_sync_labels": false,
    "auto_sync_milestones": false
  },
  "naming_conventions": {
    "format": "<identifier>.<suffix>",
    "valid_suffixes": [
      "topic",
      "project",
      "app",
      "package",
      "scaffold",
      "template",
      "overview",
      "diy"
    ],
    "organization_prefix": "chimera-lab-",
    "require_lowercase": true,
    "require_hyphens": true,
    "max_nesting_level": 4
  },
  "templates": {
    "base_template": "repository.template",
    "apply_via_github": true,
    "required_for_new_repos": true
  },
  "submodules": {
    "enabled": true,
    "auto_update": false,
    "strategy": "explicit-tracking"
  }
}
